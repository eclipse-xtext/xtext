<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.eclipse.xtext</groupId>
		<artifactId>org.eclipse.xtext.nodeploy.parent</artifactId>
		<version>2.45.0-SNAPSHOT</version>
		<relativePath>../org.eclipse.xtext.nodeploy.parent</relativePath>
	</parent>
	<artifactId>org.eclipse.xtext.junit6.tests</artifactId>
	<packaging>eclipse-test-plugin</packaging>

	<name>Xtext Core Runtime JUnit6 Tests</name>
	<description>Xtext Core Runtime Junit6 Tests.</description>

	<properties>
		<junit-platform-version>6.1.3</junit-platform-version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.eclipse.xtext</groupId>
			<artifactId>org.eclipse.xtext.testlanguages</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!--
		This bundle contains JUnit Jupiter tests only. It is executed by the
		tycho-test-plugin instead of tycho-surefire. The JUnit Platform Console
		Launcher and the engine are installed as OSGi bundles from the test
		classpath.
		-->
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-console</artifactId>
			<version>${junit-platform-version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>${junit-platform-version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<configuration>
					<!-- The tests are run by the tycho-test-plugin below. -->
					<skipTests>true</skipTests>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-test-plugin</artifactId>
				<version>${tycho-version}</version>
				<executions>
					<execution>
						<id>execute-tests</id>
						<goals>
							<goal>junit-platform</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<includeEngine>
						<engine>junit-jupiter</engine>
					</includeEngine>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
